{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aqil.internal/schemas/forecast_contract.v1.json",
  "title": "Forecast Contract v1",
  "type": "object",
  "required": [
    "schema_version",
    "forecast_id",
    "registered_at",
    "forecast_type",
    "target_definition",
    "horizon_months",
    "evaluation_date",
    "source_claim_ids",
    "method_version",
    "status",
    "falsification_rule"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "forecast_id": {
      "type": "string",
      "minLength": 1
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "forecast_type": {
      "enum": [
        "event",
        "numeric",
        "causal",
        "investment"
      ]
    },
    "target_definition": {
      "type": "string",
      "minLength": 5
    },
    "target_unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "horizon_months": {
      "enum": [
        12,
        24,
        36
      ]
    },
    "evaluation_date": {
      "type": "string",
      "format": "date"
    },
    "falsification_rule": {
      "type": "string",
      "minLength": 5
    },
    "scenario_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "method_version": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "code_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "data_snapshot_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "calibrated_probability": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "calibration_method_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "registered",
        "under_review",
        "evaluated",
        "invalidated",
        "superseded"
      ]
    },
    "baseline_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewer_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "calibrated_probability": {
            "type": "number"
          }
        }
      },
      "then": {
        "properties": {
          "calibration_method_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "calibration_method_id"
        ]
      }
    }
  ]
}
