{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aqil.internal/schemas/forward_horizon.v1.json",
  "title": "Forward horizon bundle v1",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "data_mode",
    "etfs",
    "events",
    "exposures"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "data_mode": { "const": "verified_source" } },
        "required": ["data_mode"]
      },
      "then": {
        "properties": {
          "etfs": {
            "type": "array",
            "items": {
              "properties": { "holdings_evidence": { "const": "provider_holdings" } }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "data_mode": { "enum": ["fixture_demonstration", "verified_source", "mixed"] },
    "etfs": {
      "type": "array",
      "items": { "$ref": "#/$defs/etf_summary" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/horizon_event" }
    },
    "exposures": {
      "type": "array",
      "items": { "$ref": "#/$defs/exposure_link" }
    },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario_summary" }
    },
    "outcomes": {
      "type": "array",
      "items": { "$ref": "#/$defs/outcome_summary" }
    }
  },
  "$defs": {
    "etf_summary": {
      "type": "object",
      "required": [
        "etf_id",
        "legal_name",
        "ticker",
        "exchange",
        "identity_evidence",
        "holdings_as_of",
        "completeness",
        "holdings_evidence",
        "holdings_caveat"
      ],
      "properties": {
        "etf_id": { "type": "string" },
        "legal_name": { "type": "string" },
        "ticker": { "type": "string" },
        "exchange": { "type": "string" },
        "isin": { "type": "string" },
        "identity_evidence": { "enum": ["verified_instrument_identity", "unverified"] },
        "holdings_as_of": { "type": "string", "format": "date" },
        "completeness": { "type": "string" },
        "holdings_evidence": { "enum": ["synthetic_demonstration", "provider_holdings", "not_available"] },
        "holdings_caveat": { "type": "string", "minLength": 1 },
        "top_holdings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "weight_percentage"],
            "properties": {
              "name": { "type": "string" },
              "issuer_id": { "type": "string" },
              "weight_percentage": { "type": "string" }
            }
          }
        }
      }
    },
    "horizon_event": {
      "type": "object",
      "required": [
        "event_id",
        "title",
        "category",
        "scheduled_date",
        "date_precision",
        "schedule_evidence",
        "materiality",
        "materiality_basis",
        "interpretation_status",
        "why_it_matters"
      ],
      "properties": {
        "event_id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "subject_label": { "type": "string" },
        "scheduled_date": { "type": "string" },
        "scheduled_time": { "type": ["string", "null"] },
        "timezone": { "type": ["string", "null"] },
        "date_precision": { "enum": ["confirmed", "estimated", "tentative", "unknown"] },
        "schedule_evidence": { "enum": ["verified_schedule", "synthetic_demonstration", "unverified"] },
        "materiality": { "enum": ["high", "medium", "low", "insufficient_evidence"] },
        "materiality_basis": {
          "enum": ["calculated", "insufficient_evidence", "macro_qualitative"]
        },
        "interpretation_status": { "const": "unverified" },
        "source_confidence": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "etf_ids": { "type": "array", "items": { "type": "string" } },
        "is_fixture": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "is_fixture": { "const": true } },
            "required": ["is_fixture"]
          },
          "then": {
            "properties": { "schedule_evidence": { "const": "synthetic_demonstration" } }
          }
        },
        {
          "if": {
            "properties": { "schedule_evidence": { "const": "verified_schedule" } },
            "required": ["schedule_evidence"]
          },
          "then": {
            "properties": {
              "date_precision": { "const": "confirmed" },
              "is_fixture": { "const": false }
            }
          }
        }
      ]
    },
    "exposure_link": {
      "type": "object",
      "required": [
        "event_id",
        "etf_id",
        "issuer_id",
        "weight_percentage",
        "weight_evidence",
        "materiality",
        "materiality_evidence"
      ],
      "properties": {
        "event_id": { "type": "string" },
        "etf_id": { "type": "string" },
        "issuer_id": { "type": "string" },
        "weight_percentage": { "type": "string" },
        "weight_evidence": { "enum": ["synthetic_demonstration", "provider_holdings"] },
        "materiality": { "type": "string" },
        "materiality_evidence": { "enum": ["calculated", "insufficient_evidence"] },
        "snapshot_as_of": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "weight_evidence": { "const": "synthetic_demonstration" } },
            "required": ["weight_evidence"]
          },
          "then": {
            "properties": { "materiality_evidence": { "const": "calculated" } }
          }
        }
      ]
    },
    "scenario_summary": {
      "type": "object",
      "required": ["scenario_id", "event_id", "frozen_at", "headline", "evidence_class"],
      "properties": {
        "scenario_id": { "type": "string" },
        "event_id": { "type": "string" },
        "frozen_at": { "type": "string", "format": "date-time" },
        "headline": { "type": "string" },
        "upside_case": { "type": "string" },
        "downside_case": { "type": "string" },
        "evidence_gaps": { "type": "array", "items": { "type": "string" } },
        "evidence_class": { "const": "synthetic_demonstration" },
        "record_source": { "enum": ["fixture", "database"] }
      }
    },
    "outcome_summary": {
      "type": "object",
      "required": ["outcome_id", "event_id", "scenario_id", "headline", "evidence_class"],
      "properties": {
        "outcome_id": { "type": "string" },
        "event_id": { "type": "string" },
        "scenario_id": { "type": "string" },
        "headline": { "type": "string" },
        "expectation_met": { "type": "string" },
        "surprise_assessment": { "type": "string" },
        "evidence_class": { "const": "synthetic_demonstration" }
      }
    }
  }
}
