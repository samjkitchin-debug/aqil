# Names only. Do not put real keys in this file.
# Copy the names into apps/web/.env.local, which stays gitignored.

# Public (embedded in the client bundle — never put secrets here)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only research read. Leave unset until research_worker can log in on the host.
# A loopback address is refused in production. Do not point this at the postgres superuser.
# RESEARCH_DATABASE_URL=

# Server-only ETF read. Leave unset unless a hosted ETF database exists.
# Do not point this at local aqil_etf.
# ETF_DATABASE_URL=

# Server-only. No current web route reads this. Leave it unset for ordinary sign-in.
# SUPABASE_SERVICE_ROLE_KEY=

# Google is enabled in the Supabase dashboard, not by a browser secret.
