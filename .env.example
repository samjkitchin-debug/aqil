# Copy to apps/web/.env.local for local web development.
# Public keys only in NEXT_PUBLIC_*. Never commit real secrets.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Supabase Auth user UUIDs allowed to use Aqil.
# Empty means nobody. The first Google account is never promoted automatically.
# Alternatively insert a row into public.access_grants as the database operator.
AQIL_AUTHORISED_USER_IDS=

# Google OAuth client belongs in the Supabase dashboard (or local auth env), not in the browser bundle.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
