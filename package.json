{
  "name": "aqil",
  "private": true,
  "description": "Aqil — investment intelligence and long-term wealth-building platform",
  "scripts": {
    "dev": "npm run dev --prefix apps/web",
    "build": "npm run build --prefix apps/web",
    "lint": "npm run lint --prefix apps/web",
    "typecheck": "npm run typecheck --prefix apps/web",
    "test:web": "npm run typecheck --prefix apps/web && npm run lint --prefix apps/web && npm run test:auth --prefix apps/web",
    "test:research": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-research-checks.ps1",
    "check:tokens": "node scripts/check-token-styling.mjs",
    "test:e2e": "npm run test:e2e --prefix apps/web",
    "db:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-db-tests.ps1 -Mode ResetOnly -DatabaseUrl postgresql://postgres@127.0.0.1:55432/aqil_pgtap_test",
    "db:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-db-tests.ps1 -Mode TestOnly -DatabaseUrl postgresql://postgres@127.0.0.1:55432/aqil_pgtap_test",
    "db:types": "npx supabase gen types typescript --local --schema public > apps/web/src/types/database.generated.ts",
    "test:db": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-db-tests.ps1 -DatabaseUrl postgresql://postgres@127.0.0.1:55432/aqil_pgtap_test",
    "research:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-research-preview.ps1",
    "research:ingest": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-research-ingest.ps1",
    "research:refresh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-research-refresh.ps1",
    "research:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-research-status.ps1"
  },
  "devDependencies": {
    "supabase": "2.122.0"
  }
}
